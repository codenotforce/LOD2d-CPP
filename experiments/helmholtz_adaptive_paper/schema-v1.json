{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lod2d.helmholtz-adaptive-paper.config.v1",
  "title": "Certified adaptive Helmholtz LOD paper run configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "build_hash", "case", "error_target", "evidence_policy", "git_commit",
    "hlod_prior_corrector_space_id", "hlod_prior_oversampling", "method",
    "mu0", "numerical_backend", "q0", "quadrature", "relative_energy_targets", "repeat_index",
    "rho_aud", "schema_version", "tau", "theta_H", "theta_h",
    "timing_repeats", "tolerance", "tolerances", "wavenumber", "work_limits"
  ],
  "properties": {
    "build_hash": {"type": "string", "minLength": 1},
    "case": {"enum": ["R1", "R2a", "R2b", "S"]},
    "error_target": {"enum": ["audit_space", "continuous"]},
    "evidence_policy": {"enum": ["require_verified", "allow_conditional"]},
    "git_commit": {"type": "string", "minLength": 1},
    "hlod_prior_corrector_space_id": {"type": "string"},
    "hlod_prior_oversampling": {
      "type": "integer", "minimum": -1, "maximum": 2147483647
    },
    "method": {
      "enum": ["CALOD", "HLOD", "SLOD-prior", "SLOD-matched", "UFEM", "AFEM", "HLOD-proxy"]
    },
    "mu0": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1},
    "numerical_backend": {"$ref": "#/$defs/numericalBackend"},
    "q0": {"type": "number", "exclusiveMinimum": 0},
    "quadrature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["base_triangle_order", "gaussian_triangle_order", "max_recursive_subdivisions", "singular_triangle_order"],
      "properties": {
        "base_triangle_order": {"type": "integer", "minimum": 1},
        "gaussian_triangle_order": {"type": "integer", "minimum": 1},
        "max_recursive_subdivisions": {"type": "integer", "minimum": 0},
        "singular_triangle_order": {"type": "integer", "minimum": 1}
      }
    },
    "relative_energy_targets": {
      "type": "array", "prefixItems": [{"const": 0.1}, {"const": 0.05}, {"const": 0.02}, {"const": 0.01}],
      "minItems": 4, "maxItems": 4
    },
    "repeat_index": {"type": "integer", "minimum": 0, "maximum": 4},
    "rho_aud": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1},
    "schema_version": {"const": 1},
    "tau": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1},
    "theta_H": {"enum": [0.3, 0.5, 0.7]},
    "theta_h": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
    "timing_repeats": {"const": 5},
    "tolerance": {"type": "number", "exclusiveMinimum": 0},
    "tolerances": {
      "type": "object",
      "additionalProperties": false,
      "required": ["eigen_relative_residual", "interpolation_right_inverse", "linear_relative_residual", "prolongation_composition"],
      "properties": {
        "eigen_relative_residual": {"type": "number", "exclusiveMinimum": 0},
        "interpolation_right_inverse": {"type": "number", "exclusiveMinimum": 0},
        "linear_relative_residual": {"type": "number", "exclusiveMinimum": 0},
        "prolongation_composition": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "wavenumber": {"enum": [8, 16, 32]},
    "work_limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_audit_dofs", "max_audit_refinements", "max_backend_work_units",
        "max_coarse_dofs", "max_coarse_refinements", "max_corrector_refinements",
        "max_elapsed_seconds", "max_fine_dofs", "max_oversampling",
        "max_oversampling_increments", "max_peak_memory_bytes",
        "max_state_transitions"
      ],
      "properties": {
        "max_audit_dofs": {"$ref": "#/$defs/workLimit"},
        "max_audit_refinements": {"$ref": "#/$defs/workLimit"},
        "max_backend_work_units": {"$ref": "#/$defs/workLimit"},
        "max_coarse_dofs": {"$ref": "#/$defs/workLimit"},
        "max_coarse_refinements": {"$ref": "#/$defs/workLimit"},
        "max_corrector_refinements": {"$ref": "#/$defs/workLimit"},
        "max_elapsed_seconds": {"type": "number", "minimum": 0},
        "max_fine_dofs": {"$ref": "#/$defs/workLimit"},
        "max_oversampling": {
          "type": "integer", "minimum": -1, "maximum": 2147483647
        },
        "max_oversampling_increments": {"$ref": "#/$defs/workLimit"},
        "max_peak_memory_bytes": {"$ref": "#/$defs/workLimit"},
        "max_state_transitions": {
          "type": "integer", "minimum": 1, "maximum": 9007199254740991
        }
      }
    }
  },
  "$defs": {
    "numericalBackend": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "audit_doerfler_theta", "audit_saturation_factor", "boundary_beta",
        "certificate", "certificate_constant_set_hash", "initial_coarse_level",
        "initial_fine_level", "initial_oversampling", "kernel_riesz_solver",
        "patch_solver", "petrov_mode"
      ],
      "properties": {
        "audit_doerfler_theta": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "audit_saturation_factor": {"type": "number", "minimum": 0, "exclusiveMaximum": 1},
        "boundary_beta": {"type": "number", "minimum": 0},
        "certificate": {
          "type": "object",
          "additionalProperties": false,
          "required": ["cluster_absolute_gap", "cluster_relative_gap", "conjugation_tolerance", "precision_bits", "q0"],
          "properties": {
            "cluster_absolute_gap": {"type": "number", "minimum": 0},
            "cluster_relative_gap": {"type": "number", "minimum": 0},
            "conjugation_tolerance": {"type": "number", "minimum": 0},
            "precision_bits": {"type": "integer", "minimum": 64},
            "q0": {"type": "number", "exclusiveMinimum": 0}
          }
        },
        "certificate_constant_set_hash": {
          "type": "string", "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "initial_coarse_level": {"type": "integer", "minimum": 0},
        "initial_fine_level": {"type": "integer", "minimum": 0},
        "initial_oversampling": {"type": "integer", "minimum": 0},
        "kernel_riesz_solver": {"enum": ["saddle_point", "kernel_basis_reference"]},
        "patch_solver": {
          "type": "object",
          "additionalProperties": false,
          "required": ["fallback_to_direct", "gmres", "kind", "reuse_identical_factorization", "shifted", "symbolic_cache_slots"],
          "properties": {
            "fallback_to_direct": {"type": "boolean"},
            "gmres": {
              "type": "object",
              "additionalProperties": false,
              "required": ["absolute_tolerance", "max_iterations", "relative_tolerance", "reorthogonalize", "restart"],
              "properties": {
                "absolute_tolerance": {"type": "number", "minimum": 0},
                "max_iterations": {"type": "integer", "minimum": 1},
                "relative_tolerance": {"type": "number", "exclusiveMinimum": 0},
                "reorthogonalize": {"type": "boolean"},
                "restart": {"type": "integer", "minimum": 1}
              }
            },
            "kind": {"enum": ["direct_saddle", "direct_schur", "shifted_gmres"]},
            "reuse_identical_factorization": {"type": "boolean"},
            "shifted": {
              "type": "object",
              "additionalProperties": false,
              "required": ["absolute_epsilon", "alpha", "coarse_max_dofs", "inverse", "jacobi_weight", "post_smooth", "pre_smooth", "rule"],
              "properties": {
                "absolute_epsilon": {"type": "number", "minimum": 0},
                "alpha": {"type": "number", "minimum": 0},
                "coarse_max_dofs": {"type": "integer", "minimum": 1},
                "inverse": {"enum": ["identity", "sparse_lu", "geometric_vcycle"]},
                "jacobi_weight": {"type": "number", "exclusiveMinimum": 0},
                "post_smooth": {"type": "integer", "minimum": 0},
                "pre_smooth": {"type": "integer", "minimum": 0},
                "rule": {"enum": ["kappa_squared", "patch_scaled", "absolute"]}
              }
            },
            "symbolic_cache_slots": {"type": "integer", "minimum": 1}
          }
        },
        "petrov_mode": {"enum": ["two_sided", "corrected_test_only"]}
      }
    },
    "workLimit": {
      "type": "integer", "minimum": 0, "maximum": 9007199254740991
    }
  },
  "allOf": [
    {
      "if": {"properties": {"method": {"const": "HLOD"}}, "required": ["method"]},
      "then": {
        "properties": {
          "hlod_prior_corrector_space_id": {"type": "string", "minLength": 1},
          "hlod_prior_oversampling": {"type": "integer", "minimum": 0}
        }
      }
    }
  ]
}
