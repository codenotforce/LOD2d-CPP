{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lod2d.helmholtz-adaptive-paper.practical-output.v2",
  "title": "Practical adaptive Helmholtz LOD run metadata",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "config_hash", "case", "method", "status", "claim", "stop_reason", "driver_state", "config", "files", "timing", "hardware"],
  "properties": {
    "schema_version": {"const": 2},
    "run_id": {"type": "string", "minLength": 1},
    "config_hash": {"type": "string", "pattern": "^[0-9a-f]{16}$"},
    "case": {"enum": ["R1", "R2a", "R2b", "S"]},
    "method": {"enum": ["PALOD", "HLOD-fixed", "SLOD", "UFEM", "AFEM"]},
    "status": {"enum": ["success", "interrupted", "censored_work_limit", "censored_time_limit", "censored_iteration_limit", "linear_algebra_failure", "unavailable"]},
    "claim": {"const": "implementation-study"},
    "stop_reason": {"type": "string"},
    "driver_state": {"enum": ["Converged", "ReferenceRefreshRequired", "WorkLimitReached", "Failed"]},
    "config": {"$ref": "schema-v2.json"},
    "files": {
      "type": "object",
      "additionalProperties": false,
      "required": ["iterations", "summary", "ell_history", "final_mesh"],
      "properties": {
        "iterations": {"const": "iterations.csv"},
        "summary": {"const": "summary.csv"},
        "ell_history": {"const": "ell_history.csv"},
        "final_mesh": {"const": "final_mesh.vtu"}
      }
    },
    "timing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method_seconds", "evaluation_reference_seconds", "evaluation_reference_excluded_from_method_time"],
      "properties": {
        "method_seconds": {"type": "number", "minimum": 0},
        "evaluation_reference_seconds": {"type": "number", "minimum": 0},
        "evaluation_reference_excluded_from_method_time": {"const": true}
      }
    },
    "hardware": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hardware_threads", "compiler", "peak_memory_mb"],
      "properties": {
        "hardware_threads": {"type": "integer", "minimum": 0},
        "compiler": {"type": "string", "minLength": 1},
        "peak_memory_mb": {"type": "number", "minimum": 0}
      }
    }
  }
}
